{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.page_title'|trans({}, 'app') }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        {{ 'security.login.logged_in_as'|trans({}, 'app') }} {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">{{ 'security.login.logout'|trans({}, 'app') }}</a>
                    </div>
                {% endif %}

                <h1 class="h3 mb-3 font-weight-normal text-center text-white">{{ 'security.login.title'|trans({}, 'app') }}</h1>
                
                <div class="form-group mb-3">
                    <label for="inputEmail" class="text-white">{{ 'security.login.email'|trans({}, 'app') }}</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                </div>
                
                <div class="form-group mb-3">
                    <label for="inputPassword" class="text-white">{{ 'security.login.password'|trans({}, 'app') }}</label>
                    <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-lg btn-primary w-100" type="submit">
                    {{ 'security.login.submit'|trans({}, 'app') }}
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
