{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ 'admin.dashboard.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-4 reveal-item" data-reveal-target="item">
        <div class="col">
            <h1 class="display-5 fw-bold text-white mb-0">{{ 'admin.dashboard.header'|trans({}, 'admin') }}</h1>
            <p class="text-muted">{{ 'admin.dashboard.welcome'|trans({}, 'admin') }}</p>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-4 reveal-item" data-reveal-target="item">
            <div class="card card-custom h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-primary mb-3"><i class="bi bi-trophy-fill me-2"></i>{{ 'admin.dashboard.fights_card.title'|trans({}, 'admin') }}</h3>
                    <p class="card-text text-light flex-grow-1">{{ 'admin.dashboard.fights_card.text'|trans({}, 'admin') }}</p>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_fight_index') }}" class="btn btn-outline-primary">{{ 'admin.dashboard.fights_card.btn_list'|trans({}, 'admin') }}</a>
                        <a href="{{ path('app_fight_new') }}" class="btn btn-primary">{{ 'admin.dashboard.fights_card.btn_add'|trans({}, 'admin') }}</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4 reveal-item" data-reveal-target="item">
            <div class="card card-custom h-100 border-danger">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-danger mb-3"><i class="bi bi-newspaper me-2"></i>{{ 'admin.dashboard.blog_card.title'|trans({}, 'admin') }}</h3>
                    <p class="card-text text-light flex-grow-1">{{ 'admin.dashboard.blog_card.text'|trans({}, 'admin') }}</p>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_blog_post_index') }}" class="btn btn-outline-danger">{{ 'admin.dashboard.blog_card.btn_list'|trans({}, 'admin') }}</a>
                        <a href="{{ path('app_blog_post_new') }}" class="btn btn-danger">{{ 'admin.dashboard.blog_card.btn_add'|trans({}, 'admin') }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}