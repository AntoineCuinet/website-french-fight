{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord - Admin{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-4 reveal-item" data-reveal-target="item">
        <div class="col">
            <h1 class="display-5 fw-bold text-white mb-0">Tableau de bord</h1>
            <p class="text-muted">Bienvenue dans l'interface d'administration.</p>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-4 reveal-item" data-reveal-target="item">
            <div class="card card-custom h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-primary mb-3"><i class="bi bi-trophy-fill me-2"></i>Combats</h3>
                    <p class="card-text text-light flex-grow-1">Gérer la liste des combats, ajouter des résultats, modifier les dates et les combattants.</p>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_fight_index') }}" class="btn btn-outline-primary">Voir la liste</a>
                        <a href="{{ path('app_fight_new') }}" class="btn btn-primary">Ajouter un combat</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4 reveal-item" data-reveal-target="item">
            <div class="card card-custom h-100 border-danger">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-danger mb-3"><i class="bi bi-newspaper me-2"></i>Blog</h3>
                    <p class="card-text text-light flex-grow-1">Rédiger des articles, partager des actualités et gérer le contenu éditorial.</p>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_blog_post_index') }}" class="btn btn-outline-danger">Voir les articles</a>
                        <a href="{{ path('app_blog_post_new') }}" class="btn btn-danger">Rédiger un article</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}