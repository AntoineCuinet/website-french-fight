<form method="post" action="{{ path('app_fight_delete', {'id': fight.id}) }}" onsubmit="return confirm('{{ 'admin.fight.delete.confirm'|trans({}, 'admin') }}');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fight.id) }}">
    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> {{ 'admin.fight.delete.btn'|trans({}, 'admin') }}</button>
</form>