{% extends 'base.html.twig' %}

{% block title %}Fight{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Fight</h1>

        <table class="table table-dark">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ fight.id }}</td>
                </tr>
                <tr>
                    <th>Fighter A</th>
                    <td>{{ fight.fighterA }}</td>
                </tr>
                <tr>
                    <th>Fighter B</th>
                    <td>{{ fight.fighterB }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ fight.date ? fight.date|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ fight.type }}</td>
                </tr>
                <tr>
                    <th>Result</th>
                    <td>{{ fight.result }}</td>
                </tr>
                <tr>
                    <th>Location</th>
                    <td>{{ fight.location }}</td>
                </tr>
                <tr>
                    <th>Image Url</th>
                    <td>{{ fight.imageUrl }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_fight_index') }}" class="btn btn-secondary">Back to list</a>
        <a href="{{ path('app_fight_edit', {'id': fight.id}) }}" class="btn btn-warning">Edit</a>

        {{ include('admin/fight/_delete_form.html.twig') }}
    </div>
{% endblock %}
