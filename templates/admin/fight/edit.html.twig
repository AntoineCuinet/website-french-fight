{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ 'admin.fight.edit.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center reveal-item" data-reveal-target="item">
        <div class="col-md-8">
            <div class="card card-custom border-warning">
                <div class="card-header bg-transparent border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h3 class="card-title text-warning mb-0">{{ 'admin.fight.edit.header'|trans({}, 'admin') }}</h3>
                    {{ include('admin/fight/_delete_form.html.twig') }}
                </div>
                <div class="card-body">
                    {{ include('admin/fight/_form.html.twig', {'button_label': 'admin.fight.form.update'|trans({}, 'admin')}) }}
                </div>
                <div class="card-footer bg-transparent border-top border-secondary text-end">
                    <a href="{{ path('app_fight_index') }}" class="btn btn-outline-light">{{ 'admin.action.back'|trans({}, 'admin') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}