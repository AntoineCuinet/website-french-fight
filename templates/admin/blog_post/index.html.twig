{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ 'admin.blog.index.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 reveal-item" data-reveal-target="item">
        <h1 class="text-white fw-bold">{{ 'admin.blog.index.header'|trans({}, 'admin') }}</h1>
        <a href="{{ path('app_blog_post_new') }}" class="btn btn-danger"><i class="bi bi-plus-lg"></i> {{ 'admin.blog.index.btn_new'|trans({}, 'admin') }}</a>
    </div>

    <div class="card card-custom reveal-item" data-reveal-target="item">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="bg-darker text-uppercase text-muted">
                        <tr>
                            <th class="ps-4">{{ 'admin.blog.index.table.id'|trans({}, 'admin') }}</th>
                            <th>{{ 'admin.blog.index.table.title'|trans({}, 'admin') }}</th>
                            <th>{{ 'admin.blog.index.table.date'|trans({}, 'admin') }}</th>
                            <th>{{ 'admin.blog.index.table.category'|trans({}, 'admin') }}</th>
                            <th class="text-end pe-4">{{ 'admin.blog.index.table.actions'|trans({}, 'admin') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for blog_post in blog_posts %}
                        <tr>
                            <td class="ps-4">{{ blog_post.id }}</td>
                            <td>{{ blog_post.title }}</td>
                            <td>{{ blog_post.publishedAt ? blog_post.publishedAt|date('d/m/Y H:i') : '' }}</td>
                            <td><span class="badge bg-secondary">{{ blog_post.category }}</span></td>
                            <td class="text-end pe-4">
                                <a href="{{ path('app_blog_post_show', {'id': blog_post.id}) }}" class="btn btn-sm btn-info me-1" title="{{ 'admin.action.show'|trans({}, 'admin') }}"><i class="bi bi-eye"></i> {{ 'admin.action.show'|trans({}, 'admin') }}</a>
                                <a href="{{ path('app_blog_post_edit', {'id': blog_post.id}) }}" class="btn btn-sm btn-warning" title="{{ 'admin.action.edit'|trans({}, 'admin') }}"><i class="bi bi-pencil"></i> {{ 'admin.action.edit'|trans({}, 'admin') }}</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">{{ 'admin.blog.index.table.empty'|trans({}, 'admin') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}