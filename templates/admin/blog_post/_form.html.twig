{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
    <div class="mb-3">
        {{ form_row(form.title, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.publishedAt, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.category, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_row(form.content, {'attr': {'class': 'form-control bg-dark text-white border-secondary', 'rows': 10}}) }}
    </div>

    <div class="mb-3">
        {% if form.vars.value.imageUrl %}
            <img src="{{ asset(form.vars.value.imageUrl) }}" alt="Current Image" style="max-width: 200px; height: auto; display: block; margin-bottom: 10px;">
        {% endif %}
        {{ form_row(form.imageFile, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>

    <button class="btn btn-success btn-lg w-100 mt-3">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}