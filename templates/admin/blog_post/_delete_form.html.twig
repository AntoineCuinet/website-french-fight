<form method="post" action="{{ path('app_blog_post_delete', {'id': blog_post.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog_post.id) }}">
    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
</form>