{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvel Article{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center reveal-item" data-reveal-target="item">
        <div class="col-md-8">
            <div class="card card-custom border-danger">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h3 class="card-title text-danger mb-0">Rédiger un article</h3>
                </div>
                <div class="card-body">
                    {{ include('admin/blog_post/_form.html.twig') }}
                </div>
                <div class="card-footer bg-transparent border-top border-secondary text-end">
                    <a href="{{ path('app_blog_post_index') }}" class="btn btn-outline-light">Annuler</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}