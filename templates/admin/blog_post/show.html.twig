{% extends 'base.html.twig' %}

{% block title %}BlogPost{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>BlogPost</h1>

        <table class="table table-dark">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ blog_post.id }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ blog_post.title }}</td>
                </tr>
                <tr>
                    <th>Content</th>
                    <td>{{ blog_post.content }}</td>
                </tr>
                <tr>
                    <th>Published At</th>
                    <td>{{ blog_post.publishedAt ? blog_post.publishedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>Category</th>
                    <td>{{ blog_post.category }}</td>
                </tr>
                <tr>
                    <th>Image Url</th>
                    <td>{{ blog_post.imageUrl }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_blog_post_index') }}" class="btn btn-secondary">Back to list</a>
        <a href="{{ path('app_blog_post_edit', {'id': blog_post.id}) }}" class="btn btn-warning">Edit</a>

        {{ include('admin/blog_post/_delete_form.html.twig') }}
    </div>
{% endblock %}
