{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ 'admin.blog.show.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>{{ 'admin.blog.show.header'|trans({}, 'admin') }}</h1>

        <table class="table table-dark">
            <tbody>
                <tr>
                    <th>{{ 'admin.blog.show.table.id'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.id }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.blog.show.table.title'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.title }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.blog.show.table.content'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.content }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.blog.show.table.published_at'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.publishedAt ? blog_post.publishedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.blog.show.table.category'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.category }}</td>
                </tr>
                <tr>
                    <th>{{ 'admin.blog.show.table.image_url'|trans({}, 'admin') }}</th>
                    <td>{{ blog_post.imageUrl }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_blog_post_index') }}" class="btn btn-secondary">{{ 'admin.blog.show.back_list'|trans({}, 'admin') }}</a>
        <a href="{{ path('app_blog_post_edit', {'id': blog_post.id}) }}" class="btn btn-warning">{{ 'admin.blog.show.btn_edit'|trans({}, 'admin') }}</a>

        {{ include('admin/blog_post/_delete_form.html.twig') }}
    </div>
{% endblock %}
