{% extends 'base.html.twig' %}

{% block title %}{{ 'app.meta.title'|trans({}, 'app') }} - {{ 'app.nav.home'|trans({}, 'app') }}{% endblock %}

{% block body %}
    <section class="hero-section">
        <div class="container">
            <h1 class="reveal-item" data-reveal-target="item"><span class="text-tricolor">{{ 'home.hero.title_part1'|trans({}, 'app') }}</span> <span class="text-tricolor-h1">{{ 'home.hero.title_part2'|trans({}, 'app') }}</span></h1>
            <p class="lead reveal-item" data-reveal-target="item">{{ 'home.hero.subtitle'|trans({}, 'app') }}</p>
            <div class="btn-container reveal-item" data-reveal-target="item">
                <a href="{{ path('app_fights') }}" class="btn-violent">{{ 'home.hero.cta'|trans({}, 'app') }}</a>
            </div>
        </div>
    </section>

    <section class="container py-5">
        <div class="text-center reveal-item" data-reveal-target="item">
            <h2 class="section-title">{{ 'home.latest_fights.title'|trans({}, 'app') }}</h2>
        </div>

        <div class="row mt-4">
            {% for fight in latest_fights %}
                <div class="col-md-4 mb-4 reveal-item" data-reveal-target="item">
                    <a href="{{ path('app_fight_show', {id: fight.id}) }}" class="card fight-card h-100 text-decoration-none">
                        {% if fight.imageUrl %}
                            <img src="{{ fight.imageUrl }}" class="card-img-top" alt="{{ fight.fighterA }} {{ 'home.latest_fights.card_alt'|trans({}, 'app') }} {{ fight.fighterB }}">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center">
                                <span class="fs-1">{{ 'home.latest_fights.placeholder_emoji'|trans({}, 'app') }}</span>
                            </div>
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ fight.fighterA }} <span class="text-muted">{{ 'home.latest_fights.vs'|trans({}, 'app') }}</span> {{ fight.fighterB }}</h5>
                            <p class="card-text text-muted">{{ fight.date|date('d M Y') }} • {{ fight.type }}</p>
                            {% if fight.result %}
                                <p class="fw-bold text-success">{{ 'home.latest_fights.result'|trans({}, 'app') }} {{ fight.result }}</p>
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-12 text-center reveal-item" data-reveal-target="item">
                    <p class="text-muted">{{ 'home.latest_fights.empty'|trans({}, 'app') }}</p>
                </div>
            {% endfor %}
        </div>
        
        <div class="text-center mt-4 reveal-item" data-reveal-target="item">
             <a href="{{ path('app_fights') }}" class="btn-outline-violent">{{ 'home.latest_fights.view_all'|trans({}, 'app') }}</a>
        </div>
    </section>

    <section class="container py-5">
        <div class="text-center reveal-item" data-reveal-target="item">
            <h2 class="section-title">{{ 'home.news.title'|trans({}, 'app') }}</h2>
        </div>

        <div class="row mt-4">
            {% for blog in latest_blogs %}
                <div class="col-md-4 mb-4 reveal-item" data-reveal-target="item">
                    <a href="{{ path('app_blog_show', {'id': blog.id}) }}" class="card fight-card h-100 text-decoration-none">
                        {% if blog.imageUrl %}
                            <img src="{{ blog.imageUrl }}" class="card-img-top" alt="{{ blog.title }}">
                        {% else %}
                            <div class="card-img-top bg-dark d-flex align-items-center justify-content-center">
                                <span class="fs-1">{{ 'home.news.placeholder_emoji'|trans({}, 'app') }}</span>
                            </div>
                        {% endif %}
                        <div class="card-body">
                            <div class="badge bg-primary mb-2">{{ blog.category }}</div>
                            <h5 class="card-title text-truncate">{{ blog.title }}</h5>
                            <p class="card-text text-muted small">{{ blog.publishedAt|date('d M Y') }}</p>
                            <p class="card-text">{{ blog.content|striptags|slice(0, 100) }}...</p>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-12 text-center reveal-item" data-reveal-target="item">
                    <p class="text-muted">{{ 'home.news.empty'|trans({}, 'app') }}</p>
                </div>
            {% endfor %}
        </div>
        
        <div class="text-center mt-4 reveal-item" data-reveal-target="item">
            <a href="{{ path('app_blog') }}" class="btn-outline-violent">{{ 'home.news.view_all'|trans({}, 'app') }}</a>
        </div>
    </section>
{% endblock %}