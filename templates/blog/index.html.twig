{% extends 'base.html.twig' %}

{% block title %}{{ 'app.meta.title'|trans({}, 'app') }} - {{ 'app.nav.blog'|trans({}, 'app') }}{% endblock %}

{% block body %}
    <div class="container py-5 mt-5">
        <div class="text-center mb-5">
            <h2 class="section-title">{{ 'blog.section_title'|trans({}, 'app') }}</h2>
            <p class="lead text-muted">{{ 'blog.subtitle'|trans({}, 'app') }}</p>
        </div>

        <div class="row">
            {% for post in posts %}
                <div class="col-md-4 mb-4">
                    <a href="{{ path('app_blog_show', {id: post.id}) }}" class="card fight-card h-100 text-decoration-none">
                        {% if post.imageUrl %}
                            <img src="{{ post.imageUrl }}" class="card-img-top" alt="{{ post.title }}">
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ post.title }}</h5>
                            <p class="card-text mb-auto">{{ post.content|striptags|slice(0, 100) }}...</p>
                            <div class="mt-3">
                                <span class="badge bg-secondary">{{ post.category }}</span>
                            </div>
                        </div>
                        <div class="card-footer text-muted">
                            {{ 'blog.published_on'|trans({}, 'app') }} {{ post.publishedAt|date('d/m/Y') }}
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-muted">{{ 'blog.empty'|trans({}, 'app') }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
